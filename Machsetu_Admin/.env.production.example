+# Copy to .env.local on the server and fill in real values.
#   cp .env.production.example .env.local && nano .env.local
#
# Never commit the filled-in file.

# MongoDB runs on the same box and only listens on loopback, but the
# connection still authenticates — a second service on the VPS should not be
# able to read the marketplace.
MONGODB_URI=mongodb://machsetu_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/machsetu?authSource=machsetu
MONGODB_DB=machsetu

# Signs every session token. Generate with:  openssl rand -base64 48
# Changing it signs everyone out, so set it once and keep it.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Where uploaded photos and documents are written. Keep it OUTSIDE the
# checkout — a git pull or a fresh clone must not take the files with it.
UPLOAD_DIR=/var/www/machsetu-uploads

# Registration and password-reset OTP over SMS Indori (DLT: Airtel, sender
# ELIVOR, template 1077453050123323726). The key is the "Authentication Token
# Key" on the panel's API page. With it set, every OTP is random and goes by
# SMS; leave it empty and the fixed DEFAULT_OTP below is used instead — anyone
# who knows that code can verify any number, so never launch without the key.
SMSINDORI_KEY=
# Optional — these are the defaults:
# SMSINDORI_SENDER=ELIVOR
# SMSINDORI_TEMPLATE_ID=1077453050123323726
# SMSINDORI_ROUTE=1
DEFAULT_OTP=123456

# Seed passwords for the two console accounts, read by scripts/seed-admin.mjs.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
OPS_PASSWORD=CHANGE_ME_OPS_PASSWORD
